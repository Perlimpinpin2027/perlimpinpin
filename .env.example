# Copiez ce fichier en .env et renseignez les vraies valeurs. .env est ignoré par git.

DATABASE_URL=
DIRECT_URL=

# Requis par scripts/analyze.js pour appeler l'API Anthropic
ANTHROPIC_API_KEY=

# Requis par scripts/analyze.js (étape 2 du pipeline) pour appeler l'API Mistral
MISTRAL_API_KEY=

# Espace /live (décryptage en direct, équipe éditoriale) : comptes individuels
# Secret Auth.js (next-auth) qui chiffre le cookie de session. OBLIGATOIRE : sans lui,
# personne ne peut se connecter à /live. Valeur aléatoire, propre à chaque environnement.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changer cette valeur déconnecte tout le monde.
AUTH_SECRET=
# Les comptes se créent avec : node scripts/create-live-user.js --email ... --nom "..." --generer
