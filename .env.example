# Copiez ce fichier en .env et renseignez les vraies valeurs. .env est ignoré par git.

# Exemple (valeurs factices) : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
DIRECT_URL=

# Requis par scripts/analyze.js pour appeler l'API Anthropic
ANTHROPIC_API_KEY=

# Requis par scripts/analyze.js (étape 2 du pipeline) pour appeler l'API Mistral
MISTRAL_API_KEY=

# Espace /live (décryptage en direct, équipe éditoriale) : comptes individuels
# Secret Auth.js (next-auth) qui chiffre le cookie de session. OBLIGATOIRE : sans lui,
# personne ne peut se connecter à /live. Valeur aléatoire, propre à chaque environnement.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changer cette valeur déconnecte tout le monde.
AUTH_SECRET=
# Les comptes se créent avec : node scripts/create-live-user.js --email ... --nom "..." --generer

# Pages de relecture /test (brouillons) : « code d'édition » unique, indépendant de /live.
# Sans ce code (ou s'il fait moins de 12 caractères), le mode édition n'existe pas :
# /test reste en lecture seule et personne ne peut publier. Choisir un code long et aléatoire.
# Changer cette valeur déconnecte immédiatement toutes les sessions d'édition en cours.
# La signature du cookie réutilise AUTH_SECRET (ci-dessus), qui doit donc aussi être défini.
TEST_EDIT_CODE=
# Mettre 1 pour le mode simulation : le bouton « Publier » calcule et annonce ce qui se passerait
# (nouvelle moyenne du candidat) mais n'écrit RIEN en base. Vide ou absent = vraie publication.
TEST_DRY_RUN=
