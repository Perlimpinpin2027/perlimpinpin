# Copiez ce fichier en .env et renseignez les vraies valeurs. .env est ignoré par git.

DATABASE_URL=
DIRECT_URL=

# Requis par scripts/analyze.js pour appeler l'API Anthropic
ANTHROPIC_API_KEY=

# Requis par scripts/analyze.js (étape 2 du pipeline) pour appeler l'API Mistral
MISTRAL_API_KEY=

# Espace /live (décryptage en direct, équipe éditoriale)
# Mot de passe partagé demandé sur /live/login
LIVE_ACCESS_PASSWORD=
# Secret aléatoire distinct servant à signer le cookie live_session (HMAC-SHA256).
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LIVE_SESSION_SECRET=
