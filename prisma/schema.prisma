// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidat {
  id         Int      @id @default(autoincrement())
  nom        String   @unique
  parti      String
  photoUrl   String?
  scoreMoyen Float?
  createdAt  DateTime @default(now())

  propositions Proposition[]
  liveAnalyses LiveAnalyse[]
}

model Proposition {
  id              Int      @id @default(autoincrement())
  // Titre court généré à partir de l'analyse (resume_court/mesure_reformulee),
  // pour l'affichage sur les cartes. Nullable pour les propositions
  // antérieures à l'ajout de ce champ.
  titre           String?
  texteOriginal   String
  theme           String
  dateDeclaration DateTime
  createdAt       DateTime @default(now())

  candidatId Int
  candidat   Candidat @relation(fields: [candidatId], references: [id])

  analyses     Analyse[]
  votesMesure  VoteMesure[]
}

model Analyse {
  id Int @id @default(autoincrement())

  propositionId Int
  proposition   Proposition @relation(fields: [propositionId], references: [id])

  // Score global sur 100
  scoreFaisabilite Int

  // Sous-scores du barème (poids variables selon le critère, voir
  // scripts/analyze.js — colonnes historiques, non lues par l'UI qui lit
  // directement contenuComplet.notation_detaillee ; scoreJuridique/
  // scoreOperationnel/scorePertinence portent désormais des valeurs dont le
  // nom de colonne ne correspond plus exactement au libellé du critère,
  // voir le commentaire dans saveAnalysis())
  scoreSolidite     Int
  scoreJuridique    Int
  scoreOperationnel Int
  scoreBudgetaire   Int
  scorePertinence   Int

  verdict String

  // Résumé journalistique court (~200-250 caractères) pour la carte "Prix
  // de la semaine" de la page d'accueil. Nullable pour les analyses
  // antérieures à l'ajout de ce champ.
  resumeAccueil String?

  // Texte journalistique plus développé (~400-500 caractères) pour la
  // section "Le résumé de Perlimpinpin IA" en tête de la fiche déclaration.
  // Pose la mesure et le point de tension principal, sans donner le verdict
  // ni le score. Nullable pour les analyses antérieures à ce champ.
  teaser String?

  cequiEstEtabli     String
  cequiEstProbable   String
  cequiEstDiscutable String
  cequiEstInconnu    String

  sourcesUtilisees String

  // "brouillon" | "publie"
  statut String @default("brouillon")

  // Valeur en dur, jamais dérivée automatiquement — à faire évoluer
  // manuellement (1.1, 2.0...) le jour où data/prompt-methodologie.md
  // change vraiment. Affichée sur la fiche publique.
  versionMethodologie String @default("1.0")

  // Date de dernière modification de data/prompt-methodologie.md au moment
  // de la génération de cette analyse. Jamais affichée : sert uniquement de
  // filet de sécurité d'audit interne — comparée à createdAt, elle permet de
  // repérer une analyse générée après un changement de prompt dont
  // versionMethodologie n'aurait pas été remonté manuellement. Nullable :
  // absente pour les analyses générées avant l'ajout de ce champ.
  promptFileModifiedAt DateTime?

  // Réponse JSON complète renvoyée par l'API Anthropic (sortie finale, après
  // arbitrage de l'étape 3 du pipeline)
  contenuComplet Json

  // Sortie brute du contrôle qualité Mistral (étape 2 du pipeline). Nullable :
  // absent si Mistral a échoué (mode dégradé) ou pour les analyses générées
  // avant l'ajout de cette étape.
  contreAvisMistral Json?

  // Pour chaque remarque de contreAvisMistral, ce que Claude a accepté ou
  // rejeté et pourquoi (étape 3). Usage interne, jamais exposé au lecteur.
  auditArbitrage Json?

  // Détail des tokens et du coût estimé par étape du pipeline :
  // { tokensEtape1, tokensEtape2, tokensEtape3, coutEstimeTotal, tokensEtape4? }
  coutPipeline Json?

  // --- Pipeline V4 (voir data/prompt-arbitrage.md) : sépare l'analyse
  // interne qui fait foi du contenu traduit pour l'affichage public. ---

  // Analyse canonique interne (faits, sources, degrés de certitude, les 4
  // notes, qualification juridique complète avec affirmations_juridiques).
  // Fait foi pour tout recalcul ou audit. Ne doit jamais être exposée
  // directement au front-end. Nullable : absente sur les analyses
  // générées avant le pipeline V4 (voir versionMethodologie, utilisé comme
  // discriminant explicite de schéma côté front-end plutôt que la
  // déduction par présence de champs).
  analyseCanonique Json?

  // Contenu public final (étape 4, Mistral éditorial), c'est la seule
  // donnée que le front-end doit afficher pour une fiche V4. Nullable :
  // absent si l'étape éditoriale a échoué (utiliser alors
  // contenu_public_secours produit par l'étape 3, stocké ici aussi une
  // fois retenu) ou pour les analyses antérieures au pipeline V4.
  contenuPublic Json?

  // Contrôle de fidélité de la passe éditoriale (correspondance des points
  // obligatoires, citations/nombres/dates repris, absence de nouvelle
  // affirmation). Usage interne uniquement, jamais exposé au lecteur.
  controleFideliteEditorial Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbacks Feedback[]
}

model Feedback {
  id Int @id @default(autoincrement())

  analyseId Int
  analyse   Analyse @relation(fields: [analyseId], references: [id])

  // "like" | "dislike"
  type String

  // Raison du dislike, nullable (uniquement si type = "dislike")
  raison String?

  // Texte libre si raison = "autre"
  raisonAutre String?

  createdAt DateTime @default(now())
}

// Vote du lecteur sur la mesure politique elle-même (d'accord / pas
// d'accord), distinct de Feedback (qui porte sur la qualité de l'analyse
// de Perlimpinpin). Rattaché à Proposition, pas à Analyse : l'avis du
// lecteur porte sur la mesure telle qu'annoncée, indépendamment d'une
// éventuelle nouvelle version de l'analyse.
model VoteMesure {
  id Int @id @default(autoincrement())

  propositionId Int
  proposition   Proposition @relation(fields: [propositionId], references: [id])

  // "accord" | "desaccord"
  type String

  createdAt DateTime @default(now())
}

// Message libre envoyé via la modale "Nous contacter" du header (suggestion,
// question, signalement d'erreur) — sans authentification ni rattachement à
// une fiche particulière.
model MessageContact {
  id Int @id @default(autoincrement())

  nom     String?
  email   String?
  message String

  createdAt DateTime @default(now())
}

model Source {
  id  Int    @id @default(autoincrement())
  nom String
  url String

  // "institutionnelle" | "statistique" | "juridique" | "autre"
  type String

  createdAt DateTime @default(now())
}

// Analyse lancée depuis l'espace /live (PerlimpinpinGo, équipe éditoriale) :
// texte collé, estimation préliminaire produite par l'Étape 1 allégée.
// Distincte de Proposition/Analyse (pipeline public) : jamais publiée, sans
// lien avec les fiches du site. Le candidat est facultatif (choisi à la main
// dans le formulaire ; l'analyse ne l'identifie pas elle-même).
model LiveAnalyse {
  id Int @id @default(autoincrement())

  // Texte de la déclaration collé par la rédaction
  declaration String

  // Titre court : reformulation de la première mesure analysée
  titre String

  // Score moyen des mesures analysées (0-100, arrondi) et leur nombre
  score     Int
  nbMesures Int

  // Réponse complète de l'analyse (mesures, remarque, avertissements), pour
  // pouvoir la ré-afficher plus tard
  resultat Json

  // Dossier : slug de l'un des thèmes du site (src/lib/themes.js) ou "autre",
  // choisi par l'analyse. Les dossiers de /live sont ce regroupement
  // automatique, jamais une entité gérée à la main.
  theme String @default("autre")

  // Favori de l'équipe éditoriale. Seul champ mis à jour après création
  // (table propre à /live, distincte des fiches publiques create-only).
  favori Boolean @default(false)

  // --- Structure enrichie (page dédiée /live/analyses/[id]) ---
  // Toutes nullables : les analyses créées avant cet ajout n'ont pas ces
  // champs et s'affichent en version simplifiée. Le champ `titre` ci-dessus
  // reçoit désormais un titre court généré quand il est disponible.

  // Synthèse d'ensemble (1 à 2 phrases)
  syntheseGlobale String?

  // Une phrase par axe : Chiffrage, Faisabilité, Impact
  syntheseChiffrage   String?
  syntheseFaisabilite String?
  syntheseImpact      String?

  // "élevé" | "moyen" | "faible"
  confiance String?

  // [{ texte, verdict, sources: [id, …] }] — verdict parmi Cohérent, Plutôt
  // cohérent, Incertain, Non étayé, Contredit. null = analyse antérieure au
  // format enrichi ([] = format enrichi sans affirmation extraite).
  affirmations Json?

  // [{ id, nom, date, url }] — références connues du modèle (l'analyse live
  // n'effectue pas de recherche web) : à vérifier avant diffusion.
  sources Json?

  candidatId Int?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
}
